# Database Configuration
POSTGRES_DB=codegames
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_ENV_LOCAL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# API Configuration
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# API Configuration
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
ADMIN_ROUTE=/your_admin_route_here
API_VERSION=your_api_version_here
EMAIL_USER=your_email_user_here
EMAIL_PASSWORD=your_email_password_here
DUMMY_EMAIL=your_dummy_email_here
EMAIL_FROM=your_email_from_address_here

# Web App Configuration
WEB_PORT=3000
VITE_API_URL=http://localhost:4000

# Dashboard Configuration
DASHBOARD_PORT=3001
VITE_DASHBOARD_API_URL=http://localhost:4000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Piston (code execution engine — free, no account needed)
# Local Docker (default): http://piston:2000/api/v2/execute
# Public fallback:        https://emkc.org/api/v2/piston/execute
PISTON_URL=http://piston:2000/api/v2/execute
